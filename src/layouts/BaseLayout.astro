---
// src/layouts/BaseLayout.astro
interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { title, description, activePage} = Astro.props;
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const isHome = activePage === 'home';
const isGitePage = activePage === 'la-garenne' || activePage === 'le-logis-de-feydoux';
---

<!DOCTYPE html>
<html lang="fr" class="bg-light text-dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} | Domaine de Feydoux</title>
  <meta name="description" content={description} />
</head>
<body class={isHome ? 'home-page' : ''}>

<nav class="site-nav" id="main-nav">
  <div class="nav-container">
    <a href="/" class="logo">
      Les gîtes de <span>Feydoux</span>
    </a>

    <ul class="nav-links">
      <li><a href="/gites/le-logis-de-feydoux" class={activePage === 'le-logis-de-feydoux' ? 'active' : ''}>Le Logis</a></li>
      <li><a href="/gites/la-garenne" class={activePage === 'la-garenne' ? 'active' : ''}>La Garenne</a></li>
      <li><a href="/region" class={activePage === 'region' ? 'active' : ''}>A proximité</a></li>
      <li><a href="/blog" class={activePage === 'blog' ? 'active' : ''}>Pour aller plus loin</a></li>

      {/* CORRECTION ICI : Ajout de la classe dropdown-anchor sur le li */}
      <li class="dropdown-anchor">
        {isGitePage ? (
            <a href="#booking-widget" class="nav-cta">Réserver ce gîte</a>
        ) : (
            <>
              <button class="nav-cta" id="reserve-trigger">Réserver</button>
              <div class="reserve-dropdown" id="reserve-menu">
                <a href="/gites/le-logis-de-feydoux#booking-widget">
                  <strong>Le Logis de Feydoux</strong>
                  <span>6 personnes • Piscine</span>
                </a>
                <a href="/gites/la-garenne#booking-widget">
                  <strong>La Garenne</strong>
                  <span>4 personnes • Jardin</span>
                </a>
              </div>
            </>
        )}
      </li>
    </ul>

    <button class="mobile-toggle" aria-label="Menu">
      <span class="line"></span>
      <span class="line"></span>
    </button>
  </div>
</nav>

<slot />

<Footer />

<script is:inline>
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }
  });

  const trigger = document.getElementById('reserve-trigger');
  const menu = document.getElementById('reserve-menu');

  if (trigger && menu) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('show');
    });
    document.addEventListener('click', () => menu.classList.remove('show'));
  }
</script>

</body>

<style is:global define:vars={{ isHome }}>
  :root { --nav-height: 80px; }

  body:not(.home-page) { padding-top: var(--nav-height); }

  .site-nav {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: var(--nav-height);
    z-index: 1000;
    display: flex;
    align-items: center;
    padding: 0 var(--side-pad);
    transition: all 0.3s ease;
  }

  .site-nav.scrolled {
    background: rgba(255, 255, 255, 0.95);
    height: 70px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(10px);
  }

  .nav-container {
    width: 100%;
    max-width: var(--max-width, 1300px);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    text-decoration: none;
    color: var(--dark);
  }

  .logo span {
    font-weight: 300;
    color: var(--warm);
    text-transform: uppercase;
    font-size: 0.7rem;
    display: block;
    letter-spacing: 3px;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a:not(.nav-cta) {
    text-decoration: none;
    color: var(--dark);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    position: relative;
  }

  .nav-links a:not(.nav-cta)::after {
    content: '';
    position: absolute;
    bottom: -5px; left: 0;
    width: 0; height: 1px;
    background: var(--warm);
    transition: width 0.3s;
  }

  .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }

  /* ANCRE DU DROPDOWN */
  .dropdown-anchor {
    position: relative;
  }

  .nav-cta {
    background: var(--dark);
    color: white !important;
    padding: 0.7rem 1.4rem;
    border: none;
    border-radius: 2px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.3s;
  }

  .nav-cta:hover { background: var(--warm); }

  /* DROPDOWN CORRIGÉ */
  .reserve-dropdown {
    position: absolute;
    top: calc(100% + 15px);
    right: 0; /* Maintenant aligné sur le bord droit du bouton grace au parent .dropdown-anchor */
    width: 260px;
    background: white;
    border: 1px solid #eee;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    display: none;
    flex-direction: column;
    z-index: 1001;
    border-radius: 4px;
    overflow: hidden;
  }

  .reserve-dropdown.show { display: flex; animation: slideIn 0.2s ease-out; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reserve-dropdown a {
    padding: 1.2rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid #f9f9f9;
    transition: background 0.2s;
  }

  .reserve-dropdown a:hover { background: var(--cream); }

  .reserve-dropdown strong {
    color: var(--dark);
    font-size: 0.9rem;
    margin-bottom: 4px;
  }

  .reserve-dropdown span {
    color: var(--warm);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
  }
</style>
</html>