---
// src/layouts/BaseLayout.astro
interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { title, description, activePage} = Astro.props;
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const isHome = activePage === 'home';
const isGitePage = activePage === 'la-garenne' || activePage === 'le-logis-de-feydoux';

---

<!DOCTYPE html>
<html lang="fr" class="bg-light text-dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} | Domaine de Feydoux</title>
  <meta name="description" content={description} />
</head>
<body class={isHome ? 'home-page' : ''}>

<nav class="site-nav" id="main-nav">
  <div class="nav-container">
    <a href="/" class="logo">
      Le Domaine <span>Feydoux</span>
    </a>

    <ul class="nav-links">
      <li><a href="/gites/le-logis-de-feydoux" class={activePage === 'logis' ? 'active' : ''}>Le Logis</a></li>
      <li><a href="/gites/la-garenne" class={activePage === 'garenne' ? 'active' : ''}>La Garenne</a></li>
      <li><a href="/region" class={activePage === 'region' ? 'active' : ''}>La Région</a></li>
      <li>{isGitePage ? (
          /* Sur une page gîte, on pointe vers l'ID du widget de la page */
          <a href="#booking-section" class="nav-cta">Réserver ce gîte</a>
      ) : (
          /* Ailleurs, on ouvre une sélection */
          <button class="nav-cta" id="reserve-trigger">Réserver</button>
          <div class="reserve-dropdown" id="reserve-menu">
            <a href="/gites/le-logis-de-feydoux">Le Logis de Feydoux</a>
            <a href="/gites/la-garenne">La Garenne</a>
          </div>
      )}</li>
    </ul>

    <button class="mobile-toggle" aria-label="Menu">
      <span class="line"></span>
      <span class="line"></span>
    </button>
  </div>
</nav>

<slot />

<Footer />

</body>
<style is:global define:vars={{ isHome }}>
  body {
    /* Si on n'est pas sur l'accueil, on pousse le contenu sous le menu */
    padding-top: var(--isHome) ? 0 : var(--nav-height);
  }

  /* Version plus robuste sans dépendre des variables JS si vous préférez : */
  body:not(.home-page) {
    padding-top: var(--nav-height);
  }

  :root {
    --nav-height: 80px;
  }

  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-height);
    z-index: 1000;
    transition: all 0.4s ease;
    display: flex;
    align-items: center;
    padding: 0 var(--side-pad);
  }

  /* Effet au scroll (via une classe JS plus bas) */
  .site-nav.scrolled {
    background: rgba(255, 255, 255, 0.95);
    height: 70px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(10px);
  }
  /* Quand on scrolle, on peut opacifier un tout petit peu plus */
  .site-nav.scrolled {
    background: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .nav-container {
    width: 100%;
    max-width: var(--max-width, 1300px);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    text-decoration: none;
    color: var(--dark);
    letter-spacing: 1px;
  }

  .logo span {
    font-weight: 300;
    color: var(--warm);
    text-transform: uppercase;
    font-size: 0.7rem;
    display: block;
    margin-top: -5px;
    letter-spacing: 3px;
  }

  .nav-links {
    display: flex;
    gap: 3rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--dark);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
    position: relative;
    transition: color 0.3s ease;
  }

  /* Petit trait élégant au survol */
  .nav-links a:not(.nav-cta)::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--warm);
    transition: width 0.3s ease;
  }

  .nav-links a:hover::after, .nav-links a.active::after {
    width: 100%;
  }

  /* Bouton d'action principal */
  .nav-cta {
    background: var(--dark);
    color: var(--cream) !important;
    padding: 0.8rem 1.8rem;
    border-radius: 2px;
    font-size: 0.75rem !important;
    transition: transform 0.3s ease, background 0.3s ease !important;
  }

  .nav-cta:hover {
    background: var(--warm);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .nav-links { display: none; } /* À remplacer par un menu "burger" */
  }

  .nav-cta-container { position: relative; }

  .reserve-dropdown {
    position: absolute;
    top: 120%;
    right: 0;
    background: var(--cream);
    border: 1px solid var(--stone);
    min-width: 200px;
    display: none; /* Caché par défaut */
    flex-direction: column;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }

  .reserve-dropdown.show { display: flex; }

  .reserve-dropdown a {
    padding: 1rem;
    font-size: 0.8rem;
    color: var(--dark);
    border-bottom: 1px solid var(--light);
    text-decoration: none;
  }

  .reserve-dropdown a:hover { background: white; color: var(--warm); }

</style>
<script is:inline>
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }
  });

  // Petit script JS pur pour le toggle du menu
  const trigger = document.getElementById('reserve-trigger');
  const menu = document.getElementById('reserve-menu');

  if (trigger) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('show');
    });

    // Fermer si on clique ailleurs
    document.addEventListener('click', () => menu.classList.remove('show'));
  }
</script>
</html>
