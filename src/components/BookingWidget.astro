---
interface Props {
  pricePerNight: number;
  abritelId: string;
  cleaningFee: number;
}

const { pricePerNight, abritelId, cleaningFee } = Astro.props;
---

<div class="booking-widget-container" id="booking-widget">
  <div class="booking-card">
    <div class="price-header">
      <div class="price-main">
        <span class="amount">{pricePerNight}€</span>
        <span class="label">/ nuit (à partir de)</span>
      </div>
      <div class="source-tag">Source : Abritel</div>
    </div>

    <div class="selection-box">
      <div class="date-row">
        <div class="field">
          <label>Arrivée</label>
          <input type="date" id="arrival-date" />
        </div>
        <div class="field border-left">
          <label>Départ</label>
          <input type="date" id="departure-date" />
        </div>
      </div>
      <div class="field border-top">
        <label>Voyageurs</label>
        <select id="guest-count">
          {[1, 2, 3, 4].map(n => (
              <option value={n} selected={n === 2}>{n} voyageur{n > 1 ? 's' : ''}</option>
          ))}
        </select>
      </div>
    </div>

    <button id="abritel-link-btn" class="primary-button" data-id={abritelId}>
      Vérifier sur Abritel
    </button>

    <div class="legal-notice">
      <p>
        <strong>Note importante :</strong> Les tarifs et disponibilités sont donnés à titre indicatif.
        Seule la plateforme <strong>Abritel</strong> fait foi pour le calcul final de votre séjour.
      </p>
    </div>

    <div id="estimate-summary" class="summary-box hidden">
      <h4>Estimation du séjour</h4>
      <div class="summary-item">
        <span>{pricePerNight}€ x <span id="display-nights">0</span> nuits</span>
        <span id="display-base">0€</span>
      </div>
      <div class="summary-item">
        <span>Frais de ménage</span>
        <span>{cleaningFee}€</span>
      </div>
      <div class="summary-total">
        <span>Total estimé *</span>
        <span id="display-total">0€</span>
      </div>
      <p class="footnote">* Hors taxes de séjour et frais de service Abritel.</p>
    </div>
  </div>
</div>

<style>
  .booking-widget-container {
    position: sticky;
    top: 100px;
    width: 100%;
    max-width: 380px;
  }

  .booking-card {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }

  .price-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .amount {
    display: block;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--dark);
  }

  .label {
    font-size: 0.85rem;
    color: var(--mid);
  }

  .source-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 8px;
    background: var(--cream);
    color: var(--warm);
    border-radius: 4px;
    font-weight: 600;
  }

  /* Le cadre de saisie */
  .selection-box {
    border: 1px solid #ccc;
    border-radius: 10px;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .date-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #ccc;
  }

  .field {
    padding: 12px;
    display: flex;
    flex-direction: column;
  }

  .border-left { border-left: 1px solid #ccc; }
  .border-top { border-top: 1px solid #ccc; }

  label {
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    color: #333;
    margin-bottom: 4px;
  }

  input, select {
    border: none;
    font-size: 14px;
    color: #444;
    outline: none;
    background: transparent;
    cursor: pointer;
  }

  .primary-button {
    width: 100%;
    background: linear-gradient(135deg, #E61E4D 0%, #D70466 100%);
    color: white;
    border: none;
    padding: 16px;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-bottom: 20px;
  }

  .primary-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(230, 30, 77, 0.3);
  }

  .legal-notice {
    font-size: 11px;
    color: var(--mid);
    line-height: 1.5;
    background: #f9f9f9;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  /* Résumé des prix */
  .summary-box {
    border-top: 1px solid #eee;
    padding-top: 20px;
  }

  .summary-box h4 {
    font-size: 1rem;
    margin-bottom: 16px;
    color: var(--dark);
  }

  .summary-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.95rem;
    color: var(--mid);
  }

  .summary-total {
    display: flex;
    justify-content: space-between;
    font-weight: 800;
    font-size: 1.1rem;
    margin-top: 16px;
    color: var(--dark);
    border-top: 1px dotted #ccc;
    padding-top: 16px;
  }

  .footnote {
    font-size: 10px;
    color: #999;
    margin-top: 10px;
    font-style: italic;
  }

  .hidden { display: none; }
</style>

<script is:inline define:vars={{ pricePerNight, cleaningFee }}>
  document.addEventListener('DOMContentLoaded', () => {
    const arrival = document.getElementById('arrival-date');
    const departure = document.getElementById('departure-date');
    const guests = document.getElementById('guest-count');
    const summary = document.getElementById('estimate-summary');
    const btn = document.getElementById('abritel-link-btn');

    function calculate() {
      const d1 = new Date(arrival.value);
      const d2 = new Date(departure.value);

      if (d1 && d2 && d2 > d1) {
        const nights = Math.ceil(Math.abs(d2 - d1) / (1000 * 60 * 60 * 24));
        const base = nights * pricePerNight;

        document.getElementById('display-nights').innerText = nights;
        document.getElementById('display-base').innerText = `${base}€`;
        document.getElementById('display-total').innerText = `${base + cleaningFee}€`;

        summary.classList.remove('hidden');
      } else {
        summary.classList.add('hidden');
      }
    }

    [arrival, departure].forEach(el => el.addEventListener('change', calculate));

    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const url = new URL(`https://www.abritel.fr/location-vacances/${id}`);

      if (arrival.value) url.searchParams.append('chkin', arrival.value);
      if (departure.value) url.searchParams.append('chkout', departure.value);
      if (guests.value) url.searchParams.append('adults', guests.value);

      window.open(url.toString(), '_blank');
    });
  });
</script>