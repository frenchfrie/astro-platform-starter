---
interface Props {
  pricePerNight: number;
  abritelId: string; // ex: "p2664458"
  cleaningFee: number;
}

const { pricePerNight, abritelId, cleaningFee } = Astro.props;
---

<div class="booking-widget-card" id="booking-widget">
  <div class="price-display">
    <span class="price-value">{pricePerNight}€</span>
    <span class="price-unit">/ nuit</span>
  </div>

  <div class="booking-inputs-container">
    <div class="date-grid">
      <div class="input-field border-right">
        <label for="chkin">Arrivée</label>
        <input type="date" id="chkin" name="chkin" />
      </div>
      <div class="input-field">
        <label for="chkout">Départ</label>
        <input type="date" id="chkout" name="chkout" />
      </div>
    </div>
    <div class="input-field border-top">
      <label for="adults">Voyageurs</label>
      <select id="adults" name="adults">
        <option value="1">1 voyageur</option>
        <option value="2" selected>2 voyageurs</option>
        <option value="3">3 voyageurs</option>
        <option value="4">4 voyageurs</option>
      </select>
    </div>
  </div>

  <button id="abritel-submit" class="cta-button" data-id={abritelId}>
    Vérifier la disponibilité
  </button>

  <p class="disclaimer">
    Vous serez redirigé vers <strong>Abritel</strong> pour finaliser la réservation.
    Disponibilité non garantie sur ce site.
  </p>

  <div id="price-summary" class="price-summary hidden">
    <div class="summary-line">
      <span>{pricePerNight}€ x <span id="days-count">0</span> nuits</span>
      <span id="subtotal-amount">0€</span>
    </div>
    <div class="summary-line">
      <span>Frais de ménage</span>
      <span>{cleaningFee}€</span>
    </div>
    <div class="total-line">
      <span>Total estimé</span>
      <span id="final-total">0€</span>
    </div>
  </div>
</div>

<style>
  .booking-widget-card {
    background: #ffffff;
    border: 1px solid #e2e2e2;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    width: 100%;
    max-width: 400px;
  }

  .price-display {
    margin-bottom: 24px;
  }

  .price-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--dark);
  }

  .price-unit {
    color: var(--mid);
    font-size: 0.9rem;
  }

  /* Le conteneur de formulaire style Abritel/Airbnb */
  .booking-inputs-container {
    border: 1px solid #b0b0b0;
    border-radius: 8px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .date-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .input-field {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
  }

  .border-right { border-right: 1px solid #b0b0b0; }
  .border-top { border-top: 1px solid #b0b0b0; }

  label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--dark);
    margin-bottom: 4px;
  }

  input, select {
    border: none;
    font-size: 14px;
    outline: none;
    background: transparent;
    color: var(--dark);
    padding: 0;
  }

  .cta-button {
    width: 100%;
    background-color: #E61E4D; /* Rouge Abritel */
    color: white;
    border: none;
    border-radius: 8px;
    padding: 14px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .cta-button:active {
    transform: scale(0.98);
  }

  .disclaimer {
    font-size: 12px;
    color: var(--mid);
    text-align: center;
    margin-top: 16px;
    line-height: 1.4;
  }

  /* Résumé de prix (calculé en JS) */
  .price-summary {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #eee;
  }

  .hidden { display: none; }

  .summary-line {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    color: var(--mid);
  }

  .total-line {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    color: var(--dark);
    margin-top: 16px;
    font-size: 1.1rem;
  }
</style>

<script is:inline define:vars={{ pricePerNight, cleaningFee }}>
  // Utilisation de define:vars pour injecter les données du serveur dans le client
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('abritel-submit');
    const inInput = document.getElementById('chkin');
    const outInput = document.getElementById('chkout');
    const adultsSelect = document.getElementById('adults');
    const summary = document.getElementById('price-summary');

    function updatePrice() {
      const start = new Date(inInput.value);
      const end = new Date(outInput.value);

      if (start && end && end > start) {
        const diffTime = Math.abs(end - start);
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

        document.getElementById('days-count').innerText = diffDays;
        const baseTotal = diffDays * pricePerNight;
        document.getElementById('subtotal-amount').innerText = `${baseTotal}€`;
        document.getElementById('final-total').innerText = `${baseTotal + cleaningFee}€`;

        summary.classList.remove('hidden');
      } else {
        summary.classList.add('hidden');
      }
    }

    inInput.addEventListener('change', updatePrice);
    outInput.addEventListener('change', updatePrice);

    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const chkin = inInput.value;
      const chkout = outInput.value;
      const adults = adultsSelect.value;

      // Construction de l'URL propre avec les paramètres Abritel corrects
      let url = `https://www.abritel.fr/location-vacances/${id}`;

      // On n'ajoute les paramètres que s'ils sont remplis
      const params = new URLSearchParams();
      if (chkin) params.append('chkin', chkin);
      if (chkout) params.append('chkout', chkout);
      if (adults) params.append('adults', adults);

      if (params.toString()) {
        url += `?${params.toString()}`;
      }

      window.open(url, '_blank');
    });
  });
</script>
