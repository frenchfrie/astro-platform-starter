---
interface Item {
    label: string;
    href?: string;
}

interface Props {
    items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="breadcrumb">
    <ol>
        {
            items.map((item, index) => {
                const isLast = index === items.length - 1;
                return (
                    <li>
                        {isLast ? <span aria-current="page">{item.label}</span> : <a href={item.href}>{item.label}</a>}
                        {!isLast && (
                            <span class="sep" aria-hidden="true">
                                /
                            </span>
                        )}
                    </li>
                );
            })
        }
    </ol>
</nav>

<style>
    .breadcrumb {
        padding: 1rem 0 0;
        font-size: 0.8rem;
        color: var(--mid);
    }

    ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        align-items: center;
    }

    li {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    a {
        color: var(--mid);
        text-decoration: none;
        transition: color var(--transition);
    }

    a:hover {
        color: var(--warm);
        text-decoration: underline;
    }

    span[aria-current='page'] {
        color: var(--dark);
        font-weight: 600;
    }

    .sep {
        color: var(--stone);
    }
</style>
