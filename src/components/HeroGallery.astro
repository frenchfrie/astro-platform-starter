---
// src/components/HeroGallery.astro
import { Image } from 'astro:assets';

interface Photo {
    src: ImageMetadata; // L'objet optimisé par Astro
    alt: string;
}

interface Props {
    photos: Photo[];
}

const { photos } = Astro.props;

// Sélection pour la grille
const main = photos[0];
const thumbs = photos.slice(1, 5);

// Préparation des données pour le client (JS)
// On extrait l'URL optimisée (.src) pour la lightbox
const clientPhotos = photos.map((p) => ({
    url: p.src.src,
    alt: p.alt
}));
---

<section class="hero-gallery">
    <div class="hero-main clickable" data-index="0">
        <Image src={main.src} alt={main.alt} width={1200} height={800} format="webp" draggable="false" />
        <button class="gallery-btn" id="openGallery">
            Voir les {photos.length} photos
        </button>
    </div>

    <div class="hero-grid">
        {
            thumbs.map((p, i) => (
                <div class="hero-thumb clickable" data-index={i + 1}>
                    <Image src={p.src} alt={p.alt} width={600} height={400} format="webp" draggable="false" />
                </div>
            ))
        }
    </div>
</section>

<div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lb-close" id="lbClose" aria-label="Fermer">✕</button>
    <button class="lb-prev" id="lbPrev" aria-label="Précédent">‹</button>
    <button class="lb-next" id="lbNext" aria-label="Suivant">›</button>
    <div class="lb-img-wrap">
        <img id="lbImg" src="" alt="" draggable="false" />
    </div>
    <div class="lb-thumbs" id="lbThumbs"></div>
</div>

<style>
    /* Tes styles restent identiques, ils sont corrects.
     Juste s'assurer que .clickable img a pointer-events: none */
    .hero-gallery {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        grid-template-rows: clamp(380px, 55vw, 680px);
        gap: 4px;
        margin-top: var(--nav-height);
        background: var(--cream);
    }
    .clickable {
        cursor: pointer;
        position: relative;
        overflow: hidden;
        display: block;
    }
    .clickable img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
    }
    .clickable:hover img {
        transform: scale(1.04);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 4px;
    }

    .gallery-btn {
        position: absolute;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 10;
        padding: 0.6rem 1.2rem;
        background: rgba(250, 247, 242, 0.7);
        border: none;
        cursor: pointer;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
    }

    /* ── Lightbox ── */
    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: var(--dark);
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .lightbox.open {
        display: flex;
    }

    .lb-close,
    .lb-prev,
    .lb-next {
        position: absolute;
        background: rgba(255, 255, 255, 0.05);
        border: none;
        cursor: pointer;
        color: var(--cream);
        line-height: 1;
        transition: all var(--transition);
        z-index: 1010;
    }
    .lb-close:hover,
    .lb-prev:hover,
    .lb-next:hover {
        color: var(--warm);
        background: rgba(255, 255, 255, 0.1);
    }

    .lb-close {
        top: 1.5rem;
        right: 2rem;
        font-size: 2rem;
        padding: 0.5rem;
        border-radius: 50%;
    }
    .lb-prev {
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 3rem;
        padding: 1rem;
    }
    .lb-next {
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 3rem;
        padding: 1rem;
    }

    .lb-img-wrap {
        max-width: 90vw;
        height: 70vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .lb-img-wrap img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        user-select: none;
        -webkit-user-drag: none;
    }

    .lb-thumbs {
        display: flex;
        gap: 0.75rem;
        margin-top: 2rem;
        overflow-x: auto;
        max-width: 95vw;
        padding: 10px;
        scrollbar-width: thin;
        scrollbar-color: var(--warm) transparent;
    }

    @media (max-width: 768px) {
        .hero-gallery {
            grid-template-columns: 1fr;
            grid-template-rows: 56vw 80px;
            min-height: unset;
        }

        .hero-grid {
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: 80px;
        }

        .lb-prev {
            left: 0.25rem;
            font-size: 2rem;
            padding: 0.75rem;
        }
        .lb-next {
            right: 0.25rem;
            font-size: 2rem;
            padding: 0.75rem;
        }
        .lb-close {
            padding: 0.75rem;
        }

        .lb-img-wrap {
            height: 55vh;
            max-width: 100vw;
            padding: 0 3rem;
        }

        .lb-thumbs {
            margin-top: 1rem;
        }
    }

    :global(.lb-thumb) {
        width: 80px;
        height: 60px;
        flex-shrink: 0;
        cursor: pointer;
        opacity: 0.4;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }
    :global(.lb-thumb.active) {
        opacity: 1;
        border-color: var(--warm);
        transform: translateY(-5px);
    }
</style>

<script define:vars={{ clientPhotos }}>
    let current = 0;
    const lightbox = document.getElementById('lightbox');
    const lbImg = document.getElementById('lbImg');
    const lbThumbs = document.getElementById('lbThumbs');

    function render() {
        const data = clientPhotos[current];
        lbImg.src = data.url;
        lbImg.alt = data.alt;

        document.querySelectorAll('.lb-thumb').forEach((t, i) => {
            t.classList.toggle('active', i === current);
            if (i === current) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });
    }

    function open(index) {
        current = parseInt(index);
        if (!lbThumbs.children.length) buildThumbs();
        render();
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
    }

    function buildThumbs() {
        clientPhotos.forEach((p, i) => {
            const div = document.createElement('div');
            div.className = 'lb-thumb';
            const img = document.createElement('img');
            img.src = p.url;
            img.alt = p.alt;
            img.draggable = false;
            img.addEventListener('contextmenu', (e) => e.preventDefault());
            div.appendChild(img);
            div.addEventListener('click', () => {
                current = i;
                render();
            });
            lbThumbs.appendChild(div);
        });
    }

    // Block right-click save on all gallery images
    document.querySelectorAll('.hero-gallery img, #lbImg').forEach((img) => {
        img.addEventListener('contextmenu', (e) => e.preventDefault());
    });

    // Listeners
    document.querySelectorAll('.clickable').forEach((el) => {
        el.addEventListener('click', (e) => {
            if (e.target.closest('#openGallery')) return;
            open(el.dataset.index);
        });
    });

    document.getElementById('openGallery').addEventListener('click', () => open(0));
    document.getElementById('lbClose').addEventListener('click', close);
    document.getElementById('lbPrev').addEventListener('click', () => {
        current = (current - 1 + clientPhotos.length) % clientPhotos.length;
        render();
    });
    document.getElementById('lbNext').addEventListener('click', () => {
        current = (current + 1) % clientPhotos.length;
        render();
    });

    document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') {
            current = (current - 1 + clientPhotos.length) % clientPhotos.length;
            render();
        }
        if (e.key === 'ArrowRight') {
            current = (current + 1) % clientPhotos.length;
            render();
        }
    });
</script>
