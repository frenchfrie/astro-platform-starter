---
interface Props {
    color?: string;
    height?: number | string;
    viewBox?: string;
    class?: string;
    'aria-hidden'?: boolean;
}

const { color = 'currentColor', height = 52, class: className, 'aria-hidden': ariaHidden } = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 400 500"
    height={height}
    width="auto"
    class={className}
    style={`color: ${color}; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round;`}
    aria-hidden={ariaHidden}
    role={ariaHidden ? undefined : 'img'}
>
    <g transform="translate(0,0)">
        <!-- Medaillon -->
        <circle cx="200" cy="200" r="160" fill="none" stroke-width="4"></circle>
        <circle cx="200" cy="200" r="150" fill="none" stroke-width="1"></circle>

        <!-- Textes medaillon -->
        <defs>
            <path id="topArcPath" d="M 10,210 A 160,162 0 0,1 385,220" fill="none"></path>
        </defs>

        <text font-family="Adorn Copperplate, classic-serif, serif" font-size="32" fill="black" text-rendering="geometricPrecision">
            <textPath href="#topArcPath" startOffset="50%" text-anchor="middle">Château de Feydoux</textPath>
        </text>

        <g transform="translate(200,200)">
            <!-- Dessin chateau -->

            <!-- corps -->
            <rect x="-50" y="-30" width="100" height="140" fill="none" stroke-width="1"></rect>
            <line x1="50" y1="30" x2="146" y2="30" stroke-width="1"></line>
            <line x1="50" y1="110" x2="101" y2="110" stroke-width="1"></line>

            <!-- toit -->
            <polygon points="-55,-35 55,-35 20,-100 -20,-100" fill="none" stroke-width="1"></polygon>
            <polygon points="-50,-30 -55,-35 55,-35 50,-30" fill="none" stroke-width="1"></polygon>

            <!-- antennes -->
            <line x1="-20" y1="-100" x2="-20" y2="-115" stroke-width="1"></line>
            <line x1="20" y1="-100" x2="20" y2="-115" stroke-width="1"></line>

            <!-- corniche facade -->
            <line x1="-50" y1="50" x2="50" y2="50" stroke-width="1"></line>

            <!-- fenetre -->
            <g transform="translate(0,20)">
                <rect x="-10" y="-30" width="20" height="40" fill="none" stroke-width="2"></rect>
                <line x1="0" y1="-30" x2="0" y2="10" stroke-width="1"></line>
                <line x1="-10" y1="-20" x2="10" y2="-20" stroke-width="1"></line>
                <line x1="-10" y1="0" x2="10" y2="0" stroke-width="1"></line>
                <rect x="-20" y="10" width="40" height="6" fill="none" stroke-width="1"></rect>
                <polygon points="-15,-30 -20,-35 20,-35 15,-30" fill="none" stroke-width="1"></polygon>
            </g>

            <!-- porte -->
            <rect x="-10" y="70" width="20" height="40" fill="none" stroke-width="1"></rect>
            <polygon points="-15,70 -20,65 20,65 15,70" fill="none" stroke-width="1"></polygon>
        </g>
    </g>

    <g transform="translate(200, 390)">
        <!-- Textes du bas -->
        <text x="0" y="0" text-anchor="middle" font-family="Adorn Copperplate, classic-serif, serif" font-size="26" fill="black">Ab anno MDCL </text>
        <text x="0" y="44" text-anchor="middle" font-family="Adorn Copperplate, classic-serif, serif" font-size="44" fill="black">Fidelis tamen </text>
    </g>
</svg>
