---
interface Props {
  color?: string;
  height?: number | string;
  viewBox?: string;
  class?: string;
  'aria-hidden'?: boolean;
}

const {
  color = 'currentColor',
  height = 52,
  viewBox = '940 400 960 860',
  class: className,
  'aria-hidden': ariaHidden,
} = Astro.props;
---
<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={viewBox}
    height={height}
    width="auto"
    style={`color: ${color}; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round;`}
    class={className}
    aria-hidden={ariaHidden}
    role={ariaHidden ? undefined : 'img'}
>
    <style>
        .adorn { font-family: 'Adorn Copperplate'; fill: currentColor; stroke: none; }
    </style>

    <g transform="matrix(1.333, 0, 0, -1.333, 0, 1440)">

        <ellipse cx="961.35" cy="519.12" rx="188.28" ry="211.67" stroke-width="4" />
        <ellipse cx="961.27" cy="519.15" rx="201.92" ry="227" stroke-width="8" />

        <rect x="891.18" y="372.9" width="141.44" height="201.66" stroke-width="2" />
        <path d="M 985.33,685.5 L 936.06,685.1 L 877.04,583.1 H 1044.35 Z" stroke-width="2" /> <line x1="891.18" y1="473.73" x2="1032.62" y2="473.73" stroke-width="2" />

        <rect x="945.62" y="372.9" width="32.58" height="66.18" stroke-width="2" />
        <rect x="948.5" y="497.86" width="27.22" height="52.56" stroke-width="2" />
        <path d="M 962.11,550.4 V 497.8 M 948.5,536.8 H 975.7 M 948.5,511.1 H 975.7" stroke-width="1" />

        <defs>
            <path id="txtArc" d="M 742,600 A 250,225 0 0 1 1163,640" />
        </defs>
        <text class="adorn" font-size="46" transform="translate(0, 1240) scale(1, -1)">
            <textPath href="#txtArc" startOffset="50%" text-anchor="middle">Château de Feydoux</textPath>
        </text>

        <g class="adorn" transform="scale(1, -1)">
            <text x="834.96" y="-252.18" font-size="27">Ab anno MDCL</text>
            <text x="778.21" y="-199.38" font-size="44">Fidelis tamen</text>
        </g>
    </g>
</svg>
