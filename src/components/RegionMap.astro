---
interface Marker {
    lat: number;
    lng: number;
    label: string;
    distance: string;
}

interface Props {
    markers: Marker[];
    centerLat?: number;
    centerLng?: number;
    zoom?: number;
}

const { markers, centerLat = 45.3917, centerLng = 0.735, zoom = 11 } = Astro.props;
---

<div id="region-map" class="region-map" aria-label="Carte des lieux à proximité"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    .region-map {
        width: 100%;
        height: 480px;
        border-radius: var(--radius-md);
        z-index: 1;
    }
</style>

<script define:vars={{ markers, centerLat, centerLng, zoom }}>
    import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js').then((L) => {
        const map = L.map('region-map', { scrollWheelZoom: false }).setView([centerLat, centerLng], zoom);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 18
        }).addTo(map);

        const icon = L.divIcon({
            className: '',
            html: '<div style="width:12px;height:12px;background:#c4955a;border:2px solid #fff;border-radius:50%;box-shadow:0 1px 4px rgba(0,0,0,.4)"></div>',
            iconSize: [12, 12],
            iconAnchor: [6, 6]
        });

        markers.forEach(({ lat, lng, label, distance }) => {
            L.marker([lat, lng], { icon }).addTo(map).bindPopup(`<strong>${label}</strong><br><small>${distance}</small>`);
        });
    });
</script>
