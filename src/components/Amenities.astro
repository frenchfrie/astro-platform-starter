---
interface Props {
    amenities: Record<string, string[]>;
}
const { amenities } = Astro.props;
---

<section class="amenities-container">
    <span class="section-label">Équipements</span>
    <h2>Tout le confort nécessaire</h2>

    <div class="amenities-grid">
        {Object.entries(amenities).map(([category, items]) => (
            <div class="amenity-group">
                <h4>{category}</h4>
                <ul>
                    {items.map(item => (
                        <li>{item}</li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</section>

<style>
    .amenities-container {
        margin-top: 4rem;
        padding-top: 4rem;
        border-top: 1px solid var(--stone);
    }

    .section-label {
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--warm);
        margin-bottom: 0.5rem;
    }

    h2 {
        font-family: var(--font-display);
        font-size: 2.2rem;
        margin-bottom: 3rem;
        color: var(--dark);
    }

    .amenities-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 3rem 2rem;
    }

    .amenity-group h4 {
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--dark);
        margin-bottom: 1.2rem;
        border-bottom: 1px solid var(--warm);
        display: inline-block;
        padding-bottom: 4px;
    }

    .amenity-group ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .amenity-group li {
        font-size: 0.95rem;
        color: var(--mid);
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Amélioration visuelle sur mobile */
    @media (max-width: 640px) {
        .amenities-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>