---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/layout/Hero.astro'; // Assuming this will be the drone view hero

// Placeholder for language toggle logic
const currentLang = 'fr'; // TODO: Implement actual language switching

---

<Layout title="Accueil">
    <Header currentLang={currentLang} />

    <!-- Hero Section (Drone View) -->
    <Hero title="Découvrez les Gîtes de Feydoux" subtitle="Votre évasion au cœur de la nature" imageUrl="drone-view-placeholder.jpg" />

    <!-- Présentation générale du domaine -->
    <section class="py-16 md:py-24">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-8">Bienvenue aux Gîtes de Feydoux</h2>
            <p class="text-lg text-center max-w-3xl mx-auto">
                Nichés dans un écrin de verdure, nos gîtes vous offrent une expérience unique de calme et de ressourcement.
                Profitez de nos grands espaces, de la piscine et des activités locales pour des vacances inoubliables en famille ou entre amis.
            </p>
            <!-- TODO: Add more detailed description and images -->
        </div>
    </section>

    <!-- Section cartes gîtes -->
    <section class="py-16 md:py-24 bg-gray-100">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">Nos Gîtes</h2>
            <div class="grid md:grid-cols-2 gap-8">
                <!-- Carte Gîte Le Logis de Feydoux -->
                <a href="/gites/le-logis-de-feydoux" class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
                    <img src="/path/to/le-logis-image.jpg" alt="Le Logis de Feydoux" class="rounded-t-lg w-full h-64 object-cover">
                    <div class="p-6">
                        <h3 class="text-2xl font-semibold mb-2">Le Logis de Feydoux</h3>
                        <p class="text-gray-600 mb-4">8 couchages - Piscine - Grands espaces</p>
                        <span class="inline-block bg-blue-500 text-white text-sm px-4 py-2 rounded-full">Voir le gîte</span>
                    </div>
                </a>

                <!-- Carte Gîte La Garenne -->
                <a href="/gites/la-garenne" class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
                    <img src="/path/to/la-garenne-image.jpg" alt="La Garenne" class="rounded-t-lg w-full h-64 object-cover">
                    <div class="p-6">
                        <h3 class="text-2xl font-semibold mb-2">La Garenne</h3>
                        <p class="text-gray-600 mb-4">4 couchages - SPA - Confort</p>
                        <span class="inline-block bg-green-500 text-white text-sm px-4 py-2 rounded-full">Voir le gîte</span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- Section "Ce que l'on peut faire aux environs" -->
    <section class="py-16 md:py-24">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-8">Activités aux environs</h2>
            <p class="text-lg max-w-3xl mx-auto">
                Découvrez les richesses de notre région : randonnées, visites de châteaux, dégustations de vins, et bien plus encore.
            </p>
            <!-- TODO: Intégrer la section activités réelles -->
        </div>
    </section>

    <Footer currentLang={currentLang} />
</Layout>