---
// src/pages/logis-de-feydoux.astro
import BaseLayout    from '../../layouts/BaseLayout.astro';
import HeroGallery   from '../../components/HeroGallery.astro';
import BookingWidget from '../../components/BookingWidget.astro';

const photos = [
    { src: '/src/assets/gites/le-logis-de-feydoux/Vue Le logis avec piscine.jpg', alt: 'Vue extérieure — La Garenne' },
    { src: '/src/assets/gites/le-logis-de-feydoux/Chambre grande étage 2.jpg', alt: 'Séjour' },
    { src: '/src/assets/gites/le-logis-de-feydoux/Chambre grande étage.jpg', alt: 'Cuisine' },
    { src: '/src/assets/gites/le-logis-de-feydoux/Escalier gîte Le Logis.jpg', alt: 'Chambre principale' },
    { src: '/src/assets/gites/le-logis-de-feydoux/Grande chambre étage.jpg', alt: 'Chambre double' },
    { src: '/src/assets/gites/le-logis-de-feydoux/Petite chambre étage.jpg', alt: 'Salle de bain' },
    { src: '/src/assets/gites/le-logis-de-feydoux/Petite chambre placard.jpg', alt: 'Piscine' },
];
---

<BaseLayout
    title="La Garenne — Gîte 8 personnes avec jacuzzi"
    description="Gîte de caractère pour 8 personnes avec piscine privée chauffée. Grands espaces et sérénité au Logis de Feydoux."
    activePage="la-garenne"
>

    <!-- ─── GALERIE HERO ── -->
    <HeroGallery photos={photos} />

    <!-- ─── CONTENU ── -->
    <main>
        <div class="main-layout">

            <!-- ── Colonne infos ── -->
            <div class="col-info">

                <div class="listing-header">
                    <div class="listing-title-wrap">
                        <p class="listing-location">Domaine privé · France</p>
                        <h1>La Garenne</h1>
                        <p class="listing-tagline">Grands espaces, piscine privée & sérénité absolue</p>
                    </div>
                    <div class="listing-capacity">
                        <div class="cap-item"><span class="cap-num">8</span><span class="cap-label">Personnes</span></div>
                        <div class="cap-sep"></div>
                        <div class="cap-item"><span class="cap-num">4</span><span class="cap-label">Chambres</span></div>
                        <div class="cap-sep"></div>
                        <div class="cap-item"><span class="cap-num">2</span><span class="cap-label">Salles de bain</span></div>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Points forts -->
                <div class="highlights">
                    <div class="highlight">
                        <div class="highlight-icon">⇔</div>
                        <div><strong>Grands espaces</strong><p>Propriété spacieuse avec vue dégagée sur la nature environnante</p></div>
                    </div>
                    <div class="highlight">
                        <div class="highlight-icon">◎</div>
                        <div><strong>Piscine privée chauffée</strong><p>Réservée exclusivement aux hôtes du Logis de Feydoux</p></div>
                    </div>
                    <div class="highlight">
                        <div class="highlight-icon">◈</div>
                        <div><strong>Sérénité garantie</strong><p>Aucun vis-à-vis, environnement calme et préservé</p></div>
                    </div>
                    <div class="highlight">
                        <div class="highlight-icon">⌂</div>
                        <div><strong>Caractère authentique</strong><p>Architecture de caractère rénovée avec soin et goût</p></div>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Description -->
                <div class="description">
                    <span class="section-label">Le gîte</span>
                    <h2>Un domaine hors du commun</h2>
                    <p>
                        La Garenne vous accueille dans un cadre exceptionnel où le temps semble suspendu.
                        Cette propriété de caractère, entièrement rénovée, offre de vastes espaces intérieurs et extérieurs
                        conçus pour que famille et amis puissent se retrouver, se détendre et profiter pleinement.
                    </p>
                    <p>
                        La piscine privée et chauffée est le cœur de vie estival du domaine — nichée dans un écrin de verdure,
                        elle invite à la contemplation autant qu'à la baignade.
                    </p>
                    <button class="read-more" id="readMore">Lire la suite ↓</button>
                    <div class="description-more" id="descMore" hidden>
                        <p>
                            À l'intérieur, les volumes généreux ont été pensés pour le confort de groupe : un grand séjour lumineux,
                            une cuisine entièrement équipée pour 8 convives, et des espaces de vie qui favorisent aussi bien
                            les moments partagés que l'intimité de chacun.
                        </p>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Chambres -->
                <div class="rooms">
                    <span class="section-label">Couchages</span>
                    <h2>4 chambres pour 8 personnes</h2>
                    <div class="rooms-grid">
                        <div class="room-card">
                            <div class="room-icon">🛏</div>
                            <div><strong>Chambre Maître</strong><p>Lit double (160×200) · Salle de douche privative</p></div>
                        </div>
                        <div class="room-card">
                            <div class="room-icon">🛏</div>
                            <div><strong>Chambre Double</strong><p>Lit double (140×190) · Douche commune</p></div>
                        </div>
                        <div class="room-card">
                            <div class="room-icon">🛏</div>
                            <div><strong>Chambre Simple A</strong><p>Lit simple (90×200) · Douche partagée</p></div>
                        </div>
                        <div class="room-card">
                            <div class="room-icon">🛏</div>
                            <div><strong>Chambre Simple B</strong><p>Lit simple (90×200) · Douche partagée</p></div>
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Équipements -->
                <div class="amenities">
                    <span class="section-label">Équipements</span>
                    <h2>Tout le confort nécessaire</h2>
                    <div class="amenities-grid">
                        <div class="amenity-group">
                            <h4>Extérieur</h4>
                            <ul>
                                <li>🏊 Piscine privée chauffée</li>
                                <li>🌿 Grand jardin arboré</li>
                                <li>☀️ Terrasse & salon de jardin</li>
                                <li>🔥 Barbecue / plancha</li>
                                <li>🚗 Parking privé</li>
                            </ul>
                        </div>
                        <div class="amenity-group">
                            <h4>Cuisine</h4>
                            <ul>
                                <li>🍳 Cuisine équipée grand format</li>
                                <li>🧊 Réfrigérateur + congélateur</li>
                                <li>☕ Machine à café & bouilloire</li>
                                <li>🍽 Vaisselle pour 10 personnes</li>
                                <li>🧹 Lave-vaisselle</li>
                            </ul>
                        </div>
                        <div class="amenity-group">
                            <h4>Confort</h4>
                            <ul>
                                <li>📶 Wifi haut débit</li>
                                <li>❄️ Climatisation / chauffage</li>
                                <li>📺 Télévision grand écran</li>
                                <li>🧺 Lave-linge & sèche-linge</li>
                                <li>🛁 Linge de maison fourni</li>
                            </ul>
                        </div>
                        <div class="amenity-group">
                            <h4>Services</h4>
                            <ul>
                                <li>🔑 Accueil personnalisé</li>
                                <li>🧽 Ménage de fin de séjour</li>
                                <li>📋 Guide de la région</li>
                                <li>🐾 Animaux (sur demande)</li>
                                <li>👶 Lit bébé disponible</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Piscine focus -->
                <div class="pool-feature">
                    <img src="/src/assets/gites/le-logis-de-feydoux/Vue Le logis avec piscine.jpg" alt="Piscine privée du Logis de Feydoux" />
                    <div class="pool-feat-content">
                        <span class="section-label light">L'atout du séjour</span>
                        <h2>La piscine,<br /><em>votre espace</em></h2>
                        <p>Chauffée de mai à septembre, entièrement privée. Aucun partage, seulement le clapotis de l'eau et le chant des cigales.</p>
                        <ul class="pool-specs">
                            <li><span>Dimensions</span> 10 × 5 m</li>
                            <li><span>Profondeur</span> 1,2 → 2 m</li>
                            <li><span>Chauffage</span> Mai → Septembre</li>
                            <li><span>Accès</span> Exclusif aux hôtes</li>
                        </ul>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Règles -->
                <div class="rules">
                    <span class="section-label">Informations pratiques</span>
                    <h2>À savoir avant de réserver</h2>
                    <div class="rules-grid">
                        <div class="rule"><strong>Arrivée</strong><p>À partir de 16h00</p></div>
                        <div class="rule"><strong>Départ</strong><p>Avant 11h00</p></div>
                        <div class="rule"><strong>Séjour minimum</strong><p>3 nuits (7 en haute saison)</p></div>
                        <div class="rule"><strong>Caution</strong><p>800 € (rendue sous 7 jours)</p></div>
                        <div class="rule"><strong>Fumeur</strong><p>Interdit à l'intérieur</p></div>
                        <div class="rule"><strong>Animaux</strong><p>Acceptés sur demande</p></div>
                    </div>
                </div>

            </div><!-- /col-info -->

            <!-- ── Colonne réservation ── -->
            <aside class="col-booking">
                <BookingWidget
                    pricePerNight={180}
                    cleaningFee={120}
                    maxGuests={8}
                    deposit={800}
                    email="contact@ledomaine.fr"
                    giteName="La Garenne"
                />

                <div class="other-gite">
                    <p class="other-label">Aussi disponible</p>
                    <a href="/gite-2" class="other-card">
                        <div class="other-img-placeholder"></div>
                        <div class="other-info">
                            <strong>Gîte 2</strong>
                            <span>Jacuzzi privatif · 4 pers.</span>
                        </div>
                        <span class="other-arrow">→</span>
                    </a>
                </div>
            </aside>

        </div><!-- /main-layout -->
    </main>

    <!-- ─── RÉGION ── -->
    <section class="region-strip">
        <div class="region-strip-inner">
            <div>
                <span class="section-label">Autour du Logis</span>
                <h2>La région vous attend</h2>
                <p>Marchés, randonnées, villages de caractère et gastronomie locale à portée de main.</p>
                <a href="/region" class="btn-region">Explorer →</a>
            </div>
            <div class="region-tags">
                <span>Marchés du terroir</span>
                <span>Sentiers de randonnée</span>
                <span>Villages médiévaux</span>
                <span>Caves & vignobles</span>
                <span>Rivières & baignade</span>
                <span>Restaurants étoilés</span>
            </div>
        </div>
    </section>

</BaseLayout>

<style>
    /* ── LAYOUT ── */
    main { max-width: 1280px; margin: 0 auto; }
    .main-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 4rem;
        padding: 3.5rem clamp(1.5rem, 5vw, 4rem);
        align-items: start;
    }

    /* ── HEADER LISTING ── */
    .listing-header {
        display: flex; justify-content: space-between;
        align-items: flex-start; gap: 2rem; flex-wrap: wrap;
    }
    .listing-location {
        font-size: .72rem; font-weight: 500; letter-spacing: .14em;
        text-transform: uppercase; color: var(--warm); margin-bottom: .5rem;
    }
    .listing-title-wrap h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: .4rem; }
    .listing-tagline { font-size: .95rem; color: var(--mid); font-style: italic; font-family: var(--font-display); }

    .listing-capacity {
        display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0;
        padding: 1.2rem 1.5rem; background: var(--cream); border-radius: 4px; margin-top: .5rem;
    }
    .cap-item { text-align: center; }
    .cap-num { display: block; font-family: var(--font-display); font-size: 2rem; color: var(--dark); line-height: 1; margin-bottom: .25rem; }
    .cap-label { font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; color: var(--mid); }
    .cap-sep { width: 1px; height: 40px; background: var(--stone); }

    /* ── HIGHLIGHTS ── */
    .highlights { display: flex; flex-direction: column; gap: 1.2rem; }
    .highlight { display: flex; align-items: flex-start; gap: 1.2rem; padding: .8rem 0; }
    .highlight-icon { font-size: 1.3rem; color: var(--warm); flex-shrink: 0; width: 2rem; text-align: center; }
    .highlight strong { display: block; font-family: var(--font-body); font-weight: 500; margin-bottom: .2rem; }
    .highlight p { font-size: .88rem; color: var(--mid); }

    /* ── DESCRIPTION ── */
    .divider { height: 1px; background: var(--stone); margin: 2.5rem 0; }
    .section-label {
        display: inline-block; font-family: var(--font-body);
        font-size: .68rem; font-weight: 500; letter-spacing: .18em;
        text-transform: uppercase; color: var(--warm); margin-bottom: .9rem;
    }
    .section-label.light { color: rgba(245,240,232,.6); }
    .description h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1rem; }
    .description p  { font-size: .95rem; color: var(--mid); margin-bottom: 1rem; line-height: 1.8; }
    .description-more p { margin-top: 1rem; }
    .read-more {
        background: none; border: none; cursor: pointer;
        font-family: var(--font-body); font-size: .82rem; font-weight: 500;
        letter-spacing: .06em; color: var(--dark);
        border-bottom: 1px solid var(--warm); padding-bottom: 2px;
        transition: color .2s;
    }
    .read-more:hover { color: var(--warm); }

    /* ── ROOMS ── */
    .rooms h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1.5rem; }
    .rooms-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .room-card { display: flex; gap: 1rem; align-items: flex-start; background: var(--cream); padding: 1.2rem; border-radius: 4px; }
    .room-icon { font-size: 1.4rem; flex-shrink: 0; }
    .room-card strong { display: block; font-family: var(--font-body); font-weight: 500; margin-bottom: .3rem; font-size: .9rem; }
    .room-card p { font-size: .8rem; color: var(--mid); line-height: 1.5; }

    /* ── AMENITIES ── */
    .amenities h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1.5rem; }
    .amenities-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
    .amenity-group h4 {
        font-family: var(--font-body); font-size: .7rem; font-weight: 500;
        letter-spacing: .14em; text-transform: uppercase; color: var(--warm); margin-bottom: .8rem;
    }
    .amenity-group ul { list-style: none; display: flex; flex-direction: column; gap: .5rem; }
    .amenity-group li { font-size: .88rem; color: var(--mid); }

    /* ── POOL FEATURE ── */
    .pool-feature {
        display: grid; grid-template-columns: 1fr 1fr;
        border-radius: 6px; overflow: hidden; background: var(--dark);
    }
    .pool-feature img { height: 100%; min-height: 340px; }
    .pool-feat-content { padding: 3rem 2.5rem; display: flex; flex-direction: column; justify-content: center; }
    .pool-feat-content h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--cream); margin-bottom: 1rem; }
    .pool-feat-content h2 em { font-style: italic; color: var(--warm); }
    .pool-feat-content p { font-size: .9rem; color: rgba(245,240,232,.7); margin-bottom: 1.8rem; line-height: 1.8; }
    .pool-specs { list-style: none; display: flex; flex-direction: column; gap: .6rem; }
    .pool-specs li {
        font-size: .82rem; color: rgba(245,240,232,.55);
        display: flex; gap: 1rem; align-items: baseline;
        border-bottom: 1px solid rgba(245,240,232,.08); padding-bottom: .6rem;
    }
    .pool-specs li span { color: var(--warm); font-weight: 500; min-width: 80px; }

    /* ── RULES ── */
    .rules h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1.5rem; }
    .rules-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .rule { padding: 1.2rem; background: var(--cream); border-radius: 4px; }
    .rule strong { display: block; font-family: var(--font-body); font-weight: 500; font-size: .82rem; letter-spacing: .06em; margin-bottom: .3rem; }
    .rule p { font-size: .85rem; color: var(--mid); }

    /* ── ASIDE BOOKING ── */
    .col-booking { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 1.5rem; }

    .other-gite { background: var(--cream); border-radius: 6px; padding: 1rem 1.2rem; }
    .other-label { font-size: .68rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--warm); margin-bottom: .8rem; display: block; }
    .other-card { display: flex; align-items: center; gap: 1rem; }
    .other-img-placeholder { width: 56px; height: 48px; flex-shrink: 0; background: linear-gradient(135deg,#c8b898,#a89070); border-radius: 4px; }
    .other-info { flex: 1; }
    .other-info strong { display: block; font-family: var(--font-body); font-weight: 500; font-size: .88rem; margin-bottom: .2rem; }
    .other-info span { font-size: .78rem; color: var(--mid); }
    .other-arrow { color: var(--warm); font-size: 1.2rem; }

    /* ── RÉGION ── */
    .region-strip { background: var(--dark); padding: 4rem var(--side-pad); }
    .region-strip-inner {
        max-width: 1280px; margin: 0 auto;
        display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
    }
    .region-strip h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); color: var(--cream); margin-bottom: 1rem; }
    .region-strip p  { font-size: .9rem; color: rgba(245,240,232,.65); margin-bottom: 1.5rem; }
    .btn-region {
        display: inline-block;
        border: 1px solid rgba(245,240,232,.3); color: var(--cream);
        font-size: .78rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
        padding: .7rem 1.8rem; border-radius: 2px; transition: border-color .2s, background .2s;
    }
    .btn-region:hover { border-color: var(--warm); background: rgba(200,169,110,.1); }
    .region-tags { display: flex; flex-wrap: wrap; gap: .7rem; }
    .region-tags span {
        font-size: .72rem; font-weight: 500; letter-spacing: .08em;
        border: 1px solid rgba(245,240,232,.15); color: rgba(245,240,232,.55);
        padding: .35rem 1rem; border-radius: 20px; transition: border-color .2s, color .2s;
    }
    .region-tags span:hover { border-color: var(--warm); color: var(--warm); }

    /* ── RESPONSIVE ── */
    @media (max-width: 1024px) {
        .main-layout { grid-template-columns: 1fr; }
        .col-booking { position: static; }
        .pool-feature { grid-template-columns: 1fr; }
        .pool-feature img { min-height: 280px; }
        .region-strip-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    }
    @media (max-width: 768px) {
        .listing-header { flex-direction: column; }
        .rooms-grid { grid-template-columns: 1fr; }
        .amenities-grid { grid-template-columns: 1fr; }
        .rules-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) {
        .rules-grid { grid-template-columns: 1fr; }
    }
</style>

<script>
    document.getElementById('readMore')?.addEventListener('click', function() {
        const more = document.getElementById('descMore');
        const hidden = more?.hidden;
        if (more) more.hidden = !hidden;
        this.textContent = hidden ? 'Réduire ↑' : 'Lire la suite ↓';
    });
</script>
