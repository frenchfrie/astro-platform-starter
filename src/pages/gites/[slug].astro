---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroGallery from '../../components/HeroGallery.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import GiteHeader from '../../components/GiteHeader.astro';
import Amenities from '../../components/Amenities.astro';

export async function getStaticPaths() {
    const giteEntries = await getCollection('gites');
    return giteEntries.map(entry => ({
        params: { slug: entry.id }, props: { entry },
    }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<BaseLayout title={data.title} description={data.description}>
    <HeroGallery photos={data.photos} />

    <main class="main-layout">
        <article class="col-content">
            <GiteHeader title={data.title} maxGuests={data.maxGuests} />

            <section class="description">
                <p>{data.description}</p>
            </section>

            <Amenities features={data.features} />
        </article>

        <aside class="col-booking">
            <BookingWidget
                pricePerNight={data.pricePerNight}
                cleaningFee={data.cleaningFee}
                maxGuests={data.maxGuests}
                deposit={data.deposit}
                giteName={data.title}
                email="contact@domaine-feydoux.com"
            />
        </aside>
    </main>
</BaseLayout>

<style>
    /* Uniquement la structure de la page */
    .main-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 4rem;
        max-width: var(--max-width, 1300px);
        margin: 0 auto;
        padding: 4rem var(--side-pad);
    }

    .description {
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--mid);
        margin-bottom: 4rem;
    }

    .col-booking {
        position: sticky;
        top: 100px;
        height: fit-content;
    }

    @media (max-width: 1024px) {
        .main-layout { grid-template-columns: 1fr; }
        .col-booking { position: static; }
    }
</style>
