---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroGallery from '../../components/HeroGallery.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import GiteHeader from '../../components/GiteHeader.astro';
import Amenities from '../../components/Amenities.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
    const giteEntries = await getCollection('gites');
    return giteEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry }
    }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<BaseLayout title={data.title} description={data.description} activePage={data.id}>
    <HeroGallery photos={data.photos} />

    <main class="main-layout">
        <div class="breadcrumb-row">
            <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: data.title }]} />
        </div>
        <article class="col-content">
            <GiteHeader title={data.title} maxGuests={data.maxGuests} />

            <section class="description">
                <p>{data.description}</p>
            </section>
            <Amenities amenities={data.amenities} />
        </article>

        <aside class="col-booking" id="booking-widget">
            <BookingWidget priceRange={data.priceRange} abritelId={data.abritelId} maxGuests={data.maxGuests} />
        </aside>
    </main>

    <div class="mobile-book-bar" id="mobileBookBar">
        <span class="mobile-price">{data.priceRange}</span>
        <a href="#booking-widget" class="btn-primary">Réserver</a>
    </div>

    <script>
        const bar = document.getElementById('mobileBookBar');
        const widget = document.getElementById('booking-widget');
        if (bar && widget) {
            new IntersectionObserver(([entry]) => bar.classList.toggle('is-hidden', entry.isIntersecting), { threshold: 0.1 }).observe(widget);
        }
    </script>
</BaseLayout>

<style>
    /* Uniquement la structure de la page */
    .main-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 4rem;
        max-width: var(--max-width, 1300px);
        margin: 0 auto;
        padding: 4rem var(--side-pad);
    }

    .breadcrumb-row {
        grid-column: 1 / -1;
    }

    .description {
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--mid);
        margin-bottom: 4rem;
    }

    .col-booking {
        position: sticky;
        top: 100px;
        height: fit-content;
    }

    .mobile-book-bar {
        display: none;
    }

    @media (max-width: 1024px) {
        .main-layout {
            grid-template-columns: 1fr;
        }
        .col-booking {
            position: static;
        }

        .mobile-book-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 1rem var(--side-pad);
            background: var(--cream);
            border-top: 1px solid var(--stone);
            box-shadow: var(--shadow-soft);
            z-index: 100;
        }

        .mobile-book-bar.is-hidden {
            display: none;
        }

        .mobile-price {
            font-size: 1rem;
            color: var(--dark);
        }

        .main-layout {
            padding-bottom: 6rem;
        }
    }

    @media (max-width: 640px) {
        .main-layout {
            padding-top: 2rem;
            gap: 2rem;
        }

        .description {
            font-size: 1rem;
            margin-bottom: 2.5rem;
        }
    }
</style>
