---
// logis-de-feydoux.astro — Page du Gîte "Le Logis de Feydoux"
// Assets attendus dans src/assets/feydoux/ :
//   hero.jpg          → grande photo principale (extérieur ou piscine)
//   gallery-1.jpg     → séjour / espace de vie
//   gallery-2.jpg     → cuisine
//   gallery-3.jpg     → chambre principale
//   gallery-4.jpg     → chambre double
//   gallery-5.jpg     → salle de bain
//   gallery-6.jpg     → piscine / extérieur
//   gallery-7.jpg     → jardin / grand espace
//   pool.jpg          → photo piscine mise en valeur

---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Le Logis de Feydoux — Gîte 8 personnes avec piscine</title>
    <meta name="description" content="Gîte de caractère pour 8 personnes avec piscine privée. Grands espaces, sérénité et nature au Logis de Feydoux." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ─── NAV ──────────────────────────────────────────────────── -->
<nav>
    <a href="/" class="logo">Le Domaine</a>
    <ul>
        <li><a href="/gites/logis-de-feydoux" class="active">Le Logis de Feydoux</a></li>
        <li><a href="/gites/la-garenne">La Garenne</a></li>
        <li><a href="/region">La Région</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
    </ul>
    <a href="#reserver" class="cta-nav">Réserver</a>
</nav>

<!-- ─── HERO GALERIE ─────────────────────────────────────────── -->
<section class="hero-gallery">
    <!-- Image principale -->
    <div class="hero-main">
        <img src="/src/assets/gites/le-logis-de-feydoux/Vue Le logis avec piscine.jpg" alt="Le Logis de Feydoux — vue extérieure" />
        <button class="gallery-btn" id="openGallery">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            Voir toutes les photos
        </button>
    </div>
    <!-- Grille secondaire -->
    <div class="hero-grid">
        <div class="hero-thumb"><img src="/src/assets/gites/le-logis-de-feydoux/Chambre grande étage 2.jpg" alt="Séjour" /></div>
        <div class="hero-thumb"><img src="/src/assets/gites/le-logis-de-feydoux/Chambre grande étage.jpg" alt="Cuisine" /></div>
        <div class="hero-thumb"><img src="/src/assets/gites/le-logis-de-feydoux/Escalier gîte Le Logis.jpg" alt="Piscine" /></div>
        <div class="hero-thumb"><img src="/src/assets/gites/le-logis-de-feydoux/Grande chambre étage.jpg" alt="Jardin" /></div>
    </div>
</section>

<!-- ─── LIGHTBOX GALERIE ──────────────────────────────────────── -->
<div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lb-close" id="lbClose">✕</button>
    <button class="lb-prev" id="lbPrev">‹</button>
    <button class="lb-next" id="lbNext">›</button>
    <div class="lb-img-wrap">
        <img id="lbImg" src="" alt="" />
        <p class="lb-caption" id="lbCaption"></p>
    </div>
    <div class="lb-thumbs" id="lbThumbs"></div>
</div>

<!-- ─── CONTENU PRINCIPAL ─────────────────────────────────────── -->
<main>

    <!-- Colonne gauche : infos -->
    <div class="main-layout">
        <div class="col-info">

            <!-- En-tête -->
            <div class="listing-header">
                <div class="listing-title-wrap">
                    <p class="listing-location">Domaine privé · France</p>
                    <h1>Le Logis de Feydoux</h1>
                    <p class="listing-tagline">Grands espaces, piscine privée & sérénité absolue</p>
                </div>
                <div class="listing-capacity">
                    <div class="cap-item"><span class="cap-num">8</span><span class="cap-label">Personnes</span></div>
                    <div class="cap-sep"></div>
                    <div class="cap-item"><span class="cap-num">4</span><span class="cap-label">Chambres</span></div>
                    <div class="cap-sep"></div>
                    <div class="cap-item"><span class="cap-num">2</span><span class="cap-label">Salles de bain</span></div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Points forts -->
            <div class="highlights">
                <div class="highlight">
                    <div class="highlight-icon">⇔</div>
                    <div>
                        <strong>Grands espaces</strong>
                        <p>Propriété spacieuse avec vue dégagée sur la nature environnante</p>
                    </div>
                </div>
                <div class="highlight">
                    <div class="highlight-icon">◎</div>
                    <div>
                        <strong>Piscine privée chauffée</strong>
                        <p>Réservée exclusivement aux hôtes du Logis de Feydoux</p>
                    </div>
                </div>
                <div class="highlight">
                    <div class="highlight-icon">◈</div>
                    <div>
                        <strong>Sérénité garantie</strong>
                        <p>Aucun vis-à-vis, environnement calme et préservé</p>
                    </div>
                </div>
                <div class="highlight">
                    <div class="highlight-icon">⌂</div>
                    <div>
                        <strong>Caractère authentique</strong>
                        <p>Architecture de caractère rénovée avec soin et goût</p>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Description -->
            <div class="description">
                <span class="section-label">Le gîte</span>
                <h2>Un domaine hors du commun</h2>
                <p>
                    Le Logis de Feydoux vous accueille dans un cadre exceptionnel où le temps semble suspendu.
                    Cette propriété de caractère, entièrement rénovée, offre de vastes espaces intérieurs et extérieurs
                    conçus pour que famille et amis puissent se retrouver, se détendre et profiter pleinement.
                </p>
                <p>
                    La piscine privée et chauffée est le cœur de vie estival du domaine — nichée dans un écrin de verdure,
                    elle invite à la contemplation autant qu'à la baignade. Le soir, les grands espaces extérieurs
                    se transforment en terrasse de dîner sous les étoiles.
                </p>
                <button class="read-more" id="readMore">Lire la suite ↓</button>
                <div class="description-more" id="descMore" hidden>
                    <p>
                        À l'intérieur, les volumes généreux ont été pensés pour le confort de groupe : un grand séjour lumineux,
                        une cuisine entièrement équipée pour 8 convives, et des espaces de vie qui favorisent aussi bien
                        les moments partagés que l'intimité de chacun.
                    </p>
                    <p>
                        Chaque chambre a été décorée avec soin pour allier confort contemporain et authenticité du lieu.
                        Les salles de bain, modernes et spacieuses, complètent une expérience sans compromis.
                    </p>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Chambres -->
            <div class="rooms">
                <span class="section-label">Couchages</span>
                <h2>4 chambres pour 8 personnes</h2>
                <div class="rooms-grid">
                    <div class="room-card">
                        <div class="room-icon">🛏</div>
                        <div>
                            <strong>Chambre Maître</strong>
                            <p>Lit double (160×200) · Salle de douche privative</p>
                        </div>
                    </div>
                    <div class="room-card">
                        <div class="room-icon">🛏</div>
                        <div>
                            <strong>Chambre Double</strong>
                            <p>Lit double (140×190) · Accès salle de douche commune</p>
                        </div>
                    </div>
                    <div class="room-card">
                        <div class="room-icon">🛏</div>
                        <div>
                            <strong>Chambre Simple A</strong>
                            <p>Lit simple (90×200) · Salle de douche partagée</p>
                        </div>
                    </div>
                    <div class="room-card">
                        <div class="room-icon">🛏</div>
                        <div>
                            <strong>Chambre Simple B</strong>
                            <p>Lit simple (90×200) · Salle de douche partagée</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Équipements -->
            <div class="amenities">
                <span class="section-label">Équipements</span>
                <h2>Tout le confort nécessaire</h2>
                <div class="amenities-grid">
                    <div class="amenity-group">
                        <h4>Extérieur</h4>
                        <ul>
                            <li>🏊 Piscine privée chauffée</li>
                            <li>🌿 Grand jardin arboré</li>
                            <li>☀️ Terrasse et salon de jardin</li>
                            <li>🔥 Barbecue / plancha</li>
                            <li>🚗 Parking privé</li>
                        </ul>
                    </div>
                    <div class="amenity-group">
                        <h4>Cuisine</h4>
                        <ul>
                            <li>🍳 Cuisine équipée grand format</li>
                            <li>🧊 Réfrigérateur + congélateur</li>
                            <li>☕ Machine à café & bouilloire</li>
                            <li>🍽 Vaisselle pour 10 personnes</li>
                            <li>🧹 Lave-vaisselle</li>
                        </ul>
                    </div>
                    <div class="amenity-group">
                        <h4>Confort</h4>
                        <ul>
                            <li>📶 Wifi haut débit</li>
                            <li>❄️ Climatisation / chauffage</li>
                            <li>📺 Télévision grand écran</li>
                            <li>🧺 Lave-linge & sèche-linge</li>
                            <li>🛁 Linge de maison fourni</li>
                        </ul>
                    </div>
                    <div class="amenity-group">
                        <h4>Services</h4>
                        <ul>
                            <li>🔑 Accueil personnalisé</li>
                            <li>🧽 Ménage de fin de séjour</li>
                            <li>📋 Guide de la région</li>
                            <li>🐾 Animaux acceptés (sur demande)</li>
                            <li>👶 Lit bébé disponible</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Piscine focus -->
            <div class="pool-feature">
                <img src="/src/assets/feydoux/pool.jpg" alt="Piscine du Logis de Feydoux" class="pool-feat-img" />
                <div class="pool-feat-content">
                    <span class="section-label light">L'atout du séjour</span>
                    <h2>La piscine,<br /><em>votre espace</em></h2>
                    <p>
                        Chauffée de mai à septembre, la piscine du Logis est entièrement privée.
                        Aucun partage, aucun bruit de voisinage — seulement le clapotis de l'eau
                        et le chant des cigales.
                    </p>
                    <ul class="pool-specs">
                        <li><span>Dimensions</span> 10 × 5 m</li>
                        <li><span>Profondeur</span> 1,2 → 2 m</li>
                        <li><span>Chauffage</span> Mai → Septembre</li>
                        <li><span>Accès</span> Exclusif aux hôtes</li>
                    </ul>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Règles -->
            <div class="rules">
                <span class="section-label">Informations pratiques</span>
                <h2>À savoir avant de réserver</h2>
                <div class="rules-grid">
                    <div class="rule">
                        <strong>Arrivée</strong>
                        <p>À partir de 16h00</p>
                    </div>
                    <div class="rule">
                        <strong>Départ</strong>
                        <p>Avant 11h00</p>
                    </div>
                    <div class="rule">
                        <strong>Séjour minimum</strong>
                        <p>3 nuits (7 nuits en haute saison)</p>
                    </div>
                    <div class="rule">
                        <strong>Caution</strong>
                        <p>800 € (rendue sous 7 jours)</p>
                    </div>
                    <div class="rule">
                        <strong>Fumeur</strong>
                        <p>Interdit à l'intérieur</p>
                    </div>
                    <div class="rule">
                        <strong>Animaux</strong>
                        <p>Acceptés sur demande préalable</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Colonne droite : widget réservation -->
        <aside class="col-booking">
            <div class="booking-card" id="reserver">
                <div class="booking-price">
                    <span class="price-amount">À partir de <strong>180 €</strong></span>
                    <span class="price-unit">/ nuit</span>
                </div>
                <p class="booking-note">Tarif pour 8 personnes · Piscine incluse</p>

                <div class="booking-dates">
                    <div class="date-input">
                        <label>Arrivée</label>
                        <input type="date" id="checkin" />
                    </div>
                    <div class="date-sep">→</div>
                    <div class="date-input">
                        <label>Départ</label>
                        <input type="date" id="checkout" />
                    </div>
                </div>

                <div class="booking-guests">
                    <label>Voyageurs</label>
                    <div class="guest-counter">
                        <button class="guest-btn" id="guestMinus">−</button>
                        <span id="guestCount">4</span>
                        <button class="guest-btn" id="guestPlus">+</button>
                    </div>
                </div>

                <div class="booking-summary" id="bookingSummary" hidden>
                    <div class="summary-row"><span id="summaryNights">0 nuits × 180 €</span><span id="summaryTotal">—</span></div>
                    <div class="summary-row"><span>Frais de ménage</span><span>120 €</span></div>
                    <div class="summary-row summary-total"><span>Total</span><span id="grandTotal">—</span></div>
                </div>

                <a href="mailto:contact@ledomaine.fr?subject=Réservation%20Logis%20de%20Feydoux" class="btn-book" id="btnBook">
                    Demander la disponibilité
                </a>
                <p class="booking-disclaimer">Aucun paiement à cette étape · Réponse sous 24h</p>
            </div>

            <!-- Autres gîtes -->
            <div class="other-gite">
                <p class="other-label">Aussi disponible</p>
                <a href="/gites/la-garenne" class="other-card">
                    <div class="other-img-placeholder"></div>
                    <div class="other-info">
                        <strong>Gîte 2</strong>
                        <span>Jacuzzi privatif · 4 pers.</span>
                    </div>
                    <span class="other-arrow">→</span>
                </a>
            </div>
        </aside>

    </div><!-- /main-layout -->

</main>

<!-- ─── RÉGION ────────────────────────────────────────────────── -->
<section class="region-strip">
    <div class="region-strip-inner">
        <div>
            <span class="section-label">Autour du Logis</span>
            <h2>La région vous attend</h2>
            <p>Marchés, randonnées, villages de caractère et gastronomie locale à portée de main.</p>
            <a href="/region" class="btn-region">Explorer →</a>
        </div>
        <div class="region-tags">
            <span>Marchés du terroir</span>
            <span>Sentiers de randonnée</span>
            <span>Villages médiévaux</span>
            <span>Caves & vignobles</span>
            <span>Rivières & baignade</span>
            <span>Restaurants étoilés</span>
        </div>
    </div>
</section>

<!-- ─── FOOTER ────────────────────────────────────────────────── -->
<footer>
    <div class="footer-top">
        <div class="footer-brand">
            <p class="logo">Le Domaine</p>
            <p>Des séjours d'exception,<br />des souvenirs pour la vie.</p>
        </div>
        <nav class="footer-nav">
            <h4>Hébergements</h4>
            <a href="/gites/logis-de-feydoux">Le Logis de Feydoux</a>
            <a href="/gites/la-garenne">Gîte 2</a>
        </nav>
        <nav class="footer-nav">
            <h4>Informations</h4>
            <a href="/region">La Région</a>
            <a href="/mentions-legales">Mentions légales</a>
        </nav>
        <div class="footer-contact">
            <h4>Contact</h4>
            <p>contact@ledomaine.fr</p>
            <p>+33 6 00 00 00 00</p>
        </div>
    </div>
    <div class="footer-bottom">
        <p>© 2026 Le Domaine — Tous droits réservés</p>
    </div>
</footer>

</body>
</html>

<style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --cream:  #f5f0e8;
        --stone:  #e8e0d0;
        --warm:   #c8a96e;
        --dark:   #1a1612;
        --mid:    #5a4a38;
        --light:  #faf7f2;
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body:    'Jost', sans-serif;
    }

    html { scroll-behavior: smooth; }
    body {
        background: var(--light);
        color: var(--dark);
        font-family: var(--font-body);
        font-weight: 300;
        line-height: 1.7;
        overflow-x: hidden;
    }
    h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 300; line-height: 1.2; }
    a { text-decoration: none; color: inherit; }
    img { display: block; width: 100%; height: 100%; object-fit: cover; }

    .section-label {
        display: inline-block;
        font-family: var(--font-body);
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--warm);
        margin-bottom: .9rem;
    }
    .section-label.light { color: rgba(245,240,232,.6); }

    .divider {
        height: 1px;
        background: var(--stone);
        margin: 2.5rem 0;
    }

    /* ── NAV ── */
    nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 1.1rem clamp(1.5rem, 5vw, 4rem);
        background: rgba(26,22,18,.9);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }
    nav .logo {
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-style: italic;
        color: var(--cream);
        flex-shrink: 0;
    }
    nav ul { display: flex; gap: 2rem; list-style: none; margin: 0 auto; }
    nav ul a { font-size: .78rem; letter-spacing: .06em; color: rgba(245,240,232,.65); transition: color .2s; }
    nav ul a:hover, nav ul a.active { color: var(--warm); }
    .cta-nav {
        font-size: .74rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
        color: var(--dark); background: var(--warm);
        padding: .5rem 1.3rem; border-radius: 2px; flex-shrink: 0;
        transition: opacity .2s;
    }
    .cta-nav:hover { opacity: .85; }

    /* ── HERO GALLERY ── */
    .hero-gallery {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        grid-template-rows: 70vh;
        min-height: 480px;
        gap: 4px;
        margin-top: 56px; /* nav height */
        background: var(--dark);
    }
    .hero-main {
        position: relative;
        overflow: hidden;
    }
    .hero-main img {
        width: 100%; height: 100%;
        transition: transform .6s ease;
    }
    .hero-main:hover img { transform: scale(1.03); }

    .gallery-btn {
        position: absolute;
        bottom: 1.5rem; right: 1.5rem;
        display: flex; align-items: center; gap: .5rem;
        background: rgba(250,247,242,.95);
        color: var(--dark);
        border: none; cursor: pointer;
        font-family: var(--font-body);
        font-size: .75rem; font-weight: 500; letter-spacing: .08em;
        padding: .6rem 1.2rem;
        border-radius: 2px;
        transition: background .2s;
    }
    .gallery-btn:hover { background: var(--cream); }

    .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 4px;
    }
    .hero-thumb { overflow: hidden; }
    .hero-thumb img { transition: transform .5s ease; }
    .hero-thumb:hover img { transform: scale(1.06); }

    /* ── LIGHTBOX ── */
    .lightbox {
        position: fixed; inset: 0; z-index: 1000;
        background: rgba(10,8,6,.97);
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }
    .lightbox.open { display: flex; }

    .lb-close, .lb-prev, .lb-next {
        position: absolute;
        background: none; border: none; cursor: pointer;
        color: rgba(245,240,232,.7);
        font-size: 2rem; line-height: 1;
        transition: color .2s;
    }
    .lb-close:hover, .lb-prev:hover, .lb-next:hover { color: var(--warm); }
    .lb-close { top: 1.5rem; right: 2rem; font-size: 1.4rem; }
    .lb-prev { left: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 3rem; }
    .lb-next { right: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 3rem; }

    .lb-img-wrap {
        max-width: 900px; width: 100%;
        display: flex; flex-direction: column; align-items: center;
        gap: 1rem;
    }
    .lb-img-wrap img {
        max-height: 65vh; width: auto; max-width: 100%;
        object-fit: contain;
    }
    .lb-caption {
        font-size: .78rem; color: rgba(245,240,232,.5);
        letter-spacing: .08em;
    }
    .lb-thumbs {
        display: flex; gap: .5rem; margin-top: 1rem;
        overflow-x: auto; max-width: 100%;
        padding-bottom: .5rem;
    }
    .lb-thumb {
        width: 60px; height: 45px; flex-shrink: 0;
        overflow: hidden; cursor: pointer; opacity: .5;
        border: 2px solid transparent;
        transition: opacity .2s, border-color .2s;
    }
    .lb-thumb.active { opacity: 1; border-color: var(--warm); }
    .lb-thumb img { width: 100%; height: 100%; object-fit: cover; }

    /* ── MAIN LAYOUT ── */
    main { max-width: 1280px; margin: 0 auto; }
    .main-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 4rem;
        padding: 3.5rem clamp(1.5rem, 5vw, 4rem);
        align-items: start;
    }

    /* ── LISTING HEADER ── */
    .listing-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2rem;
        flex-wrap: wrap;
    }
    .listing-location {
        font-size: .72rem; font-weight: 500; letter-spacing: .14em;
        text-transform: uppercase; color: var(--warm);
        margin-bottom: .5rem;
    }
    .listing-title-wrap h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: .4rem;
    }
    .listing-tagline {
        font-size: .95rem; color: var(--mid);
        font-style: italic;
        font-family: var(--font-display);
    }
    .listing-capacity {
        display: flex;
        align-items: center;
        gap: 1.5rem;
