</style>

<script>
    // ── Guest counter
    let guests = 4;
    const maxGuests = 8;
    const minGuests = 1;
    const guestCountEl = document.getElementById('guestCount');

    document.getElementById('guestMinus').addEventListener('click', () => {
        if (guests > minGuests) { guests--; guestCountEl.textContent = guests; updateSummary(); }
    });
    document.getElementById('guestPlus').addEventListener('click', () => {
        if (guests < maxGuests) { guests++; guestCountEl.textContent = guests; updateSummary(); }
    });

    // ── Booking summary
    function updateSummary() {
        const checkin = document.getElementById('checkin').value;
        const checkout = document.getElementById('checkout').value;
        const summaryEl = document.getElementById('bookingSummary');
        if (!checkin || !checkout) return;
        const d1 = new Date(checkin), d2 = new Date(checkout);
        const nights = Math.round((d2 - d1) / 86400000);
        if (nights <= 0) return;
        const pricePerNight = 180;
        const cleaning = 120;
        const total = nights * pricePerNight + cleaning;
        document.getElementById('summaryNights').textContent = `${nights} nuit${nights > 1 ? 's' : ''} × ${pricePerNight} €`;
        document.getElementById('summaryTotal').textContent = `${nights * pricePerNight} €`;
        document.getElementById('grandTotal').textContent = `${total} €`;
        summaryEl.hidden = false;

        // Update mailto link
        const btn = document.getElementById('btnBook');
        const checkinFr = new Date(checkin).toLocaleDateString('fr-FR');
        const checkoutFr = new Date(checkout).toLocaleDateString('fr-FR');
        btn.href = `mailto:contact@ledomaine.fr?subject=Réservation%20Logis%20de%20Feydoux&body=Bonjour%2C%0A%0AJe%20souhaite%20réserver%20le%20Logis%20de%20Feydoux%20du%20${encodeURIComponent(checkinFr)}%20au%20${encodeURIComponent(checkoutFr)}%20pour%20${guests}%20personne${guests>1?'s':''}.%0A%0AMerci.`;
    }

    document.getElementById('checkin').addEventListener('change', updateSummary);
    document.getElementById('checkout').addEventListener('change', updateSummary);

    // ── Read more
    document.getElementById('readMore').addEventListener('click', function() {
        const more = document.getElementById('descMore');
        const isHidden = more.hidden;
        more.hidden = !isHidden;
        this.textContent = isHidden ? 'Réduire ↑' : 'Lire la suite ↓';
    });

    // ── Lightbox
    const photos = [
        { src: '/src/assets/gites/le-logis-de-feydoux/Vue Le logis avec piscine.jpg', caption: 'Vue extérieure' },
        { src: '/src/assets/gites/le-logis-de-feydoux/Chambre grande étage 2.jpg', caption: 'Séjour' },
        { src: '/src/assets/gites/le-logis-de-feydoux/Chambre grande étage.jpg', caption: 'Cuisine' },
        { src: '/src/assets/gites/le-logis-de-feydoux/Escalier gîte Le Logis.jpg', caption: 'Chambre principale' },
        { src: '/src/assets/gites/le-logis-de-feydoux/Grande chambre étage.jpg', caption: 'Chambre double' },
        { src: '/src/assets/gites/le-logis-de-feydoux/Petite chambre étage.jpg', caption: 'Salle de bain' },
        { src: '/src/assets/gites/le-logis-de-feydoux/Petite chambre placard.jpg', caption: 'Piscine' },
    ];

    let currentPhoto = 0;
    const lightbox = document.getElementById('lightbox');
    const lbImg = document.getElementById('lbImg');
    const lbCaption = document.getElementById('lbCaption');
    const lbThumbs = document.getElementById('lbThumbs');

    function openLightbox(index) {
        currentPhoto = index;
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        renderLightbox();
        if (lbThumbs.children.length === 0) buildThumbs();
    }

    function closeLightbox() {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    }

    function renderLightbox() {
        lbImg.src = photos[currentPhoto].src;
        lbImg.alt = photos[currentPhoto].caption;
        lbCaption.textContent = `${photos[currentPhoto].caption} · ${currentPhoto + 1} / ${photos.length}`;
        document.querySelectorAll('.lb-thumb').forEach((t, i) => t.classList.toggle('active', i === currentPhoto));
    }

    function buildThumbs() {
        photos.forEach((p, i) => {
            const div = document.createElement('div');
            div.className = 'lb-thumb' + (i === 0 ? ' active' : '');
            const img = document.createElement('img');
            img.src = p.src; img.alt = p.caption;
            div.appendChild(img);
            div.addEventListener('click', () => { currentPhoto = i; renderLightbox(); });
            lbThumbs.appendChild(div);
        });
    }

    document.getElementById('openGallery').addEventListener('click', () => openLightbox(0));
    document.getElementById('lbClose').addEventListener('click', closeLightbox);
    document.getElementById('lbPrev').addEventListener('click', () => { currentPhoto = (currentPhoto - 1 + photos.length) % photos.length; renderLightbox(); });
    document.getElementById('lbNext').addEventListener('click', () => { currentPhoto = (currentPhoto + 1) % photos.length; renderLightbox(); });
    document.addEventListener('keydown', e => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') { currentPhoto = (currentPhoto - 1 + photos.length) % photos.length; renderLightbox(); }
        if (e.key === 'ArrowRight') { currentPhoto = (currentPhoto + 1) % photos.length; renderLightbox(); }
    });
</script>
