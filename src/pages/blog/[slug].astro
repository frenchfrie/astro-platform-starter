---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content'; // Pour le typage strict
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const blogEntries = await getCollection('blog');
    return blogEntries.map(entry => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allPosts = await getCollection('blog');

const relatedPosts = allPosts
    .filter(post => {
        // 1. Exclure l'article en cours de lecture
        const isNotCurrent = post.slug !== entry.slug;
        // 2. Vérifier si c'est la même catégorie
        const isSameCategory = post.data.category === entry.data.category;
        return isNotCurrent && isSameCategory;
    })
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) // Les plus récents d'abord
    .slice(0, 2); // On en garde 2

// On type explicitement entry
interface Props {
    entry: CollectionEntry<'blog'>;
}

// Si on n'a pas assez d'articles dans la même catégorie, on complète avec les derniers articles
const fallbackPosts = relatedPosts.length < 2
    ? allPosts
        .filter(post => post.slug !== entry.slug && !relatedPosts.find(r => r.slug === post.slug))
        .slice(0, 2 - relatedPosts.length)
    : [];

const finalRelatedPosts = [...relatedPosts, ...fallbackPosts];

const formattedDate = entry.data.date.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});

---

<BaseLayout title={entry.data.title} activePage="blog">
    <article class="article-wrapper">

        <header class="article-header">
            <div class="meta">
                <span class="category">{entry.data.category.replace(/-/g, ' ')}</span>
                <span class="sep">•</span>
                <time>{formattedDate}</time>
            </div>
            <h1>{entry.data.title}</h1>
            <p class="lead">{entry.data.excerpt}</p>
        </header>

        {entry.data.image && (
            <div class="main-image-container">
                <img src={entry.data.image} alt="" />
            </div>
        )}

        <div class="content-body">
            <div class="prose">
                <Content />
            </div>
        </div>

        <footer class="article-footer">
            <div class="footer-divider">
                <span class="divider-icon">∗</span>
            </div>

            {relatedPosts.length > 0 && (
                <section class="suggestions">
                    <h3 class="suggestion-title">
                        <span>Exploration : {entry.data.category}</span>
                        Continuer la lecture
                    </h3>
                    <div class="suggestion-grid">
                        {finalRelatedPosts.map(post => (
                            <a href={`/blog/${post.slug}`} class="suggestion-card">
                                <div class="card-meta">DANS {post.data.category.toUpperCase()}</div>
                                <h4>{post.data.title}</h4>
                                <span class="link-text">Lire l'article</span>
                            </a>
                        ))}
                    </div>
                </section>
            )}

            <div class="navigation-bottom">
                <a href="/blog" class="btn-back">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    Retour au blog
                </a>
            </div>
        </footer>
    </article>
</BaseLayout>

<style>
    /* 1. Conteneur principal restrictif pour la lisibilité */
    .article-wrapper {
        max-width: 800px;
        margin: 0 auto;
        padding: 6rem 1.5rem;
    }

    /* 2. Header épuré */
    .article-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .meta {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--warm);
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .sep { margin: 0 10px; color: var(--stone); }

    h1 {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3.2rem);
        color: var(--dark);
        line-height: 1.2;
        margin-bottom: 1.5rem;
    }

    .lead {
        font-size: 1.15rem;
        color: var(--mid);
        line-height: 1.6;
        font-style: italic;
    }

    /* 3. Image contenue */
    .main-image-container {
        margin-bottom: 3rem;
        border-radius: 4px;
        overflow: hidden;
    }

    .main-image-container img {
        width: 100%;
        height: auto;
        max-height: 450px;
        object-fit: cover;
    }

    /* 4. Corps du texte (Prose) */
    .prose {
        color: #333;
        line-height: 1.8;
        font-size: 1.1rem;
    }

    .prose :global(h2) {
        font-family: var(--font-display);
        font-size: 1.8rem;
        margin: 2.5rem 0 1rem;
        color: var(--dark);
    }

    .prose :global(p) { margin-bottom: 1.5rem; }

    /* 5. Section "À lire aussi" enfin décente */
    .article-footer { margin-top: 5rem; }

    hr { border: 0; border-top: 1px solid #eee; margin-bottom: 3rem; }

    .related-posts h3 {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1.5rem;
        color: var(--dark);
    }

    .related-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .related-item {
        padding: 1.5rem;
        border: 1px solid #eee;
        text-decoration: none;
        transition: border-color 0.2s;
        border-radius: 4px;
    }

    .related-item:hover { border-color: var(--warm); }

    .related-cat {
        font-size: 0.7rem;
        text-transform: uppercase;
        color: var(--warm);
        font-weight: 700;
        display: block;
        margin-bottom: 0.5rem;
    }

    .related-item h4 {
        font-size: 1rem;
        color: var(--dark);
        margin: 0;
        line-height: 1.4;
    }

    .actions {
        margin-top: 4rem;
        text-align: center;
    }

    .back-link {
        font-size: 0.9rem;
        color: var(--mid);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
    }

    .back-link:hover { border-color: var(--mid); }

    @media (max-width: 600px) {
        .related-list { grid-template-columns: 1fr; }
    }

    .article-footer {
        margin-top: 5rem;
        padding-bottom: 4rem;
    }

    /* Séparateur élégant */
    .footer-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 4rem;
    }

    .footer-divider::before, .footer-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #eee;
    }

    .divider-icon {
        padding: 0 20px;
        color: var(--warm);
        font-size: 1.2rem;
    }

    /* Section Suggestions */
    .suggestion-title {
        font-family: var(--font-display);
        font-size: 1.4rem;
        color: var(--dark);
        margin-bottom: 2rem;
        text-align: center;
    }

    .suggestion-title span {
        color: var(--warm);
        font-style: italic;
    }

    .suggestion-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    .suggestion-card {
        display: block;
        padding: 2rem;
        border: 1px solid #f0f0f0;
        text-decoration: none;
        transition: all 0.3s ease;
        background: #fff;
    }

    .suggestion-card:hover {
        border-color: var(--warm);
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transform: translateY(-3px);
    }

    .card-meta {
        font-size: 0.65rem;
        letter-spacing: 0.15em;
        color: #999;
        margin-bottom: 1rem;
        font-weight: 700;
    }

    .suggestion-card h4 {
        font-family: var(--font-display);
        font-size: 1.2rem;
        color: var(--dark);
        line-height: 1.4;
        margin-bottom: 1.5rem;
    }

    .link-text {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--warm);
        border-bottom: 1px solid transparent;
        transition: border 0.2s;
    }

    .suggestion-card:hover .link-text {
        border-bottom-color: var(--warm);
    }

    /* Navigation retour */
    .navigation-bottom {
        margin-top: 5rem;
        display: flex;
        justify-content: center;
    }

    .btn-back {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--mid);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 12px 24px;
        border: 1px solid #eee;
        border-radius: 50px;
        transition: all 0.2s;
    }

    .btn-back:hover {
        background: var(--dark);
        color: #fff;
        border-color: var(--dark);
    }

    @media (max-width: 700px) {
        .suggestion-grid { grid-template-columns: 1fr; }
    }
     .article-footer {
         margin-top: 8rem; /* On donne de l'air après le texte */
         padding: 4rem 0;
         background: transparent; /* Suppression du fond noir */
         border-top: 1px solid #eee; /* Une ligne simple pour séparer */
     }

    /* Titre de section minimaliste */
    .suggestion-title {
        font-family: var(--font-display);
        font-size: 1.8rem;
        color: var(--dark);
        margin-bottom: 3rem;
        text-align: center;
        font-style: italic;
    }

    .suggestion-title span {
        color: var(--warm);
        font-style: normal;
        font-family: sans-serif;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        display: block;
        margin-bottom: 0.5rem;
    }

    .suggestion-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        max-width: 800px; /* On reste aligné sur la largeur du texte */
        margin: 0 auto;
    }

    .suggestion-card {
        text-decoration: none;
        transition: opacity 0.3s ease;
    }

    .suggestion-card:hover {
        opacity: 0.7;
    }

    .card-meta {
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: var(--warm);
        margin-bottom: 0.75rem;
        font-weight: 700;
    }

    .suggestion-card h4 {
        font-family: var(--font-display);
        font-size: 1.3rem;
        color: var(--dark);
        line-height: 1.3;
        margin-bottom: 1rem;
    }

    .link-text {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--mid);
        border-bottom: 1px solid var(--stone);
        padding-bottom: 2px;
    }

    /* Bouton retour ultra-discret */
    .navigation-bottom {
        margin-top: 6rem;
        text-align: center;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--mid);
        text-decoration: none;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: color 0.2s;
    }

    .btn-back:hover {
        color: var(--warm);
    }
</style>
