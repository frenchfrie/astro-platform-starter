---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const locations = await getCollection('region');
---

<BaseLayout title="Découvrir le Périgord Vert" activePage="region">
    <main class="page-container">
        <header class="region-header">
            <span class="label">Aux alentours</span>
            <h1>Le Périgord Vert</h1>
            <p class="lead">Villages classés, abbayes médiévales, grottes préhistoriques et marchés de terroir — le Domaine de Feydoux est au cœur d'un patrimoine exceptionnel, tout accessible en moins de 25 minutes.</p>
        </header>

        {locations.map((loc, i) => (
            <section class="discovery-section">
                <div class={`discovery-grid${i % 2 !== 0 ? ' reverse' : ''}`}>
                    <div class="discovery-text">
                        <h2>{loc.data.title}</h2>
                        <p class="distance">{loc.data.distance}</p>
                        <p>{loc.data.description}</p>
                        <ul class="highlights">
                            {loc.data.highlights.map(h => <li>∗ {h}</li>)}
                        </ul>
                    </div>
                    <div class="discovery-image">
                        {loc.data.image
                            ? <Image src={loc.data.image as ImageMetadata} alt={loc.data.imageAlt ?? loc.data.title} width={800} height={500} format="webp" />
                            : <div class="image-placeholder"><span>Photo : {loc.data.title}</span></div>
                        }
                    </div>
                </div>
            </section>
        ))}
    </main>
</BaseLayout>

<style>
    .region-header {
        text-align: center;
        max-width: 800px;
        margin: 0 auto 8rem;
    }

    .region-header h1 {
        font-family: var(--font-display);
        font-size: clamp(3rem, 8vw, 5rem);
        font-style: italic;
        color: var(--dark);
        line-height: 1;
        margin: 0.5rem 0 2rem;
    }

    .discovery-section {
        margin-bottom: 8rem;
        padding: 4rem 0;
    }

    .discovery-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: center;
    }

    .discovery-grid.reverse {
        direction: rtl;
    }

    .discovery-grid.reverse .discovery-text {
        direction: ltr;
    }

    .discovery-text h2 {
        font-family: var(--font-display);
        font-size: 2.5rem;
        color: var(--dark);
        margin-bottom: 1rem;
    }

    .distance {
        color: var(--warm);
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        margin-bottom: 2rem;
        font-weight: 600;
    }

    .discovery-text p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--mid);
        margin-bottom: 1.5rem;
    }

    .highlights {
        list-style: none;
        padding: 0;
        margin-top: 2rem;
        display: grid;
        gap: 0.5rem;
    }

    .highlights li {
        color: var(--dark);
        font-size: 0.9rem;
        font-weight: 500;
    }

    .image-placeholder {
        background-color: var(--stone);
        aspect-ratio: 16/10;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mid);
        font-style: italic;
        border-radius: var(--radius-sm);
    }

    @media (max-width: 900px) {
        .discovery-grid, .discovery-grid.reverse {
            grid-template-columns: 1fr;
            gap: 3rem;
            direction: ltr;
        }
        .region-header { margin-bottom: 4rem; }
    }
</style>
