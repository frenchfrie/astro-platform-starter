---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
// Importe une belle photo de famille ou du domaine si tu en as une
// import familleImg from '../assets/domaine-famille.jpg';

import photoDomaine from '../assets/feydoux/chateau-face.jpg';
---

<BaseLayout title="Notre Histoire" activePage="a-propos">
    <main class="page-container">
        <header class="about-header">
            <span class="label">L'âme du lieu</span>
            <h1>Notre Histoire</h1>
        </header>

        <section class="story-grid">
            <div class="story-text">
                <p class="lead">
                    Le Domaine de Feydoux n'est pas seulement une destination de vacances, c'est un projet de vie né d'un coup de cœur pour les pierres dorées
                    du Périgord Vert.
                </p>
                <p>
                    Amoureux de cette région depuis toujours, nous avons entrepris de restaurer ce domaine pour en faire un havre de paix où le temps semble
                    s'être arrêté. Notre souhait était de préserver l'architecture vernaculaire tout en y insufflant le confort moderne indispensable à un
                    séjour ressourçant.
                </p>
                <p>
                    Aujourd'hui, nous sommes heureux de partager ce petit coin de paradis avec vous. Que vous logiez au Logis ou à La Garenne, chaque pierre
                    raconte une part de l'histoire de la Dordogne que nous avons à cœur de perpétuer.
                </p>
            </div>
            <div class="story-image">
                <Image src={photoDomaine} alt="Vue du Domaine de Feydoux" width={800} height={600} class="about-img" quality="high" />
            </div>
        </section>

        <section class="values-section">
            <div class="value-card">
                <span class="value-icon">🌿</span>
                <h3>Nature</h3>
                <p>Un domaine préservé où la biodiversité et le calme sont nos priorités.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">🏰</span>
                <h3>Patrimoine</h3>
                <p>Une restauration fidèle aux traditions artisanales du Périgord.</p>
            </div>
            <div class="value-card">
                <span class="value-icon">🤝</span>
                <h3>Accueil</h3>
                <p>Un accueil personnalisé et des conseils locaux pour un séjour unique.</p>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .about-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .about-header h1 {
        font-family: var(--font-display);
        font-size: clamp(3rem, 7vw, 4.5rem);
        font-style: italic;
        color: var(--dark);
        margin-top: 0.5rem;
    }

    .story-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: center;
        margin-bottom: 8rem;
    }

    .story-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: var(--mid);
    }

    .story-text .lead {
        font-size: 1.4rem;
        color: var(--dark);
        font-family: var(--font-display);
        margin-bottom: 2rem;
        line-height: 1.4;
    }

    .story-text p {
        margin-bottom: 1.5rem;
    }

    .about-img {
        width: 100%;
        height: auto;
        border-radius: 2px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        object-fit: cover;
    }

    .values-section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3rem;
        padding: 4rem;
        background-color: var(--cream);
        border-radius: 4px;
    }

    .value-card {
        text-align: center;
    }

    .value-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 1rem;
    }

    .value-card h3 {
        font-family: var(--font-display);
        font-size: 1.8rem;
        color: var(--dark);
        margin-bottom: 1rem;
    }

    .value-card p {
        font-size: 0.95rem;
        color: var(--mid);
        line-height: 1.6;
    }

    @media (max-width: 900px) {
        .story-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
        .values-section {
            grid-template-columns: 1fr;
            padding: 3rem 2rem;
        }
    }
</style>
